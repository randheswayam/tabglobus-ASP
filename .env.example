# Copy to .env (git-ignored) and fill in before `docker compose up`.
# POSTGRES_PASSWORD only takes effect when the database volume is first created.
POSTGRES_PASSWORD=
# A long random string, for example from: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Password for the seed users, created on first start. Leave empty to skip seeding.
SEED_PASSWORD=
